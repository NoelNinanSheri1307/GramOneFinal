# ---- GramOne environment configuration ----
# Copy this file to `.env` and fill in real values locally.
# Never commit the real `.env` file.

# Environment: development | test | production
ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Application
# Comma-separated list of allowed CORS origins.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Bearer token used by hardware / trusted services when full auth is not yet in place.
# OPTIONAL for the foundation stage. Keep empty until authentication exists.
API_PREFIX=/api/v1

# Database (PostgreSQL)
# Example local URL:
# postgresql+psycopg2://gramone:gramone@localhost:5432/gramone
DATABASE_URL=postgresql+psycopg2://gramone:gramone@localhost:5432/gramone

# Authentication (JWT)
# REQUIRED for a running backend outside ENVIRONMENT=test (startup fails fast).
# Generate locally, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Never commit a real value.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI service (OpenRouter)
# The key and model are read from environment configuration only; never commit
# a real key. Names only here — values live in the developer's local .env.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Frontend origin (used by any client-facing links)
FRONTEND_ORIGIN=http://localhost:5173

# External news provider (NewsData.io)
NEWSDATA_API_KEY=